# The fly-through's sample walker, drawn as text (Plan 0063). Regenerate walker.vox with
#   cargo run -p vxe-assets --example voxtext -- to-vox walker.voxtext walker.vox
# Layers run from the bottom up (z is up); in a layer the first row is the back (largest y)
# and the last row the front (y 0), which the walker faces.
color b 1 140 133 122   # the body: the table's `walker` row
color g 2 230 180 100   # unused; kept so the palette matches the rig's `material 2` line
color e 185 0 255 51    # the eyes: `walker eye`, which glows
model torso
